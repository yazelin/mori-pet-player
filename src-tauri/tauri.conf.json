{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mori Pet Player",
  "version": "0.1.0",
  "identifier": "ai.yazelin.mori-pet-player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "Mori Pet Player",
        "width": 184,
        "height": 184,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "用 Mori 角色包養一隻桌面夥伴",
    "longDescription": "載入 MoriPack，讓角色在桌面漫步、休息，也能被使用者抓起來移動。",
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
